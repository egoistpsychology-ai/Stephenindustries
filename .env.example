GROQ_API_KEY=
DEEPSEEK_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
GITHUB_TOKEN=
GITHUB_REPO=owner/name
GOOGLE_CREDENTIALS_FILE=
MAX_COST_USD_PER_TASK=0.50
MAX_DELEGATIONS_PER_TASK=10
CREWAI_STORAGE_DIR=./.memory
AUDIT_DB_PATH=./audit.sqlite
# Groq openai/gpt-oss-20b, published standard rates per 1M tokens.
GROQ_INPUT_USD_PER_MILLION=0.075
GROQ_OUTPUT_USD_PER_MILLION=0.30
# DeepSeek deepseek-flash, off-peak cache-miss input and output rates per 1M tokens.
# Peak rates are double; cache-hit input is cheaper and not modeled by this estimator.
DEEPSEEK_INPUT_USD_PER_MILLION=0.15
DEEPSEEK_OUTPUT_USD_PER_MILLION=0.60
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
